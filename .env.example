# Copia este archivo como .env y rellena las claves. Nunca lo subas a git.
#
# La clave 1 (Claude Code) NO va aquí: va en la variable de entorno ANTHROPIC_API_KEY del sistema.
# Clave 2: la usa el agente de la app (y el despliegue).
ANTHROPIC_API_KEY_PRODUCTO=
# Clave 3: la usan las evals (python evals/ejecutar.py).
ANTHROPIC_API_KEY_EVALS=

# Opcional: cotizaciones con Alpha Vantage (clave gratuita, 25 consultas al día).
ALPHA_VANTAGE_API_KEY=

# Comportamiento del agente
NOMBRE_PRODUCTO=Finanzas IA
MODELO_CHAT=sonnet
ESFUERZO_CHAT=medium
MAX_VUELTAS=8
MAX_TOKENS=4000
MAX_HISTORIAL=40
REVISOR_CUMPLIMIENTO=1
# off | grabar | reproducir (plan B de la demo)
MODO_DEMO=off
# Herramientas del servidor de Anthropic (la búsqueda cuesta 10 $ por 1.000)
BUSQUEDA_WEB=0
EJECUCION_CODIGO=0
PERFIL_DEMO=familia
GUARDAR_PERFILES=1

# Web permitida (CORS). En producción, la URL de Vercel.
ORIGENES_CORS=http://localhost:3000,http://127.0.0.1:3000
